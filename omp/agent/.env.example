# API keys for the AGENTS.md task-routing agents (nemotron, gemini, deepseek,
# deepseek-r, diagram) and the /flux script.
#
# bootstrap.sh copies this file to ~/.omp/agent/.env the first time it runs on
# a machine (never overwriting an existing one) — fill in real values there,
# not here. Only this .example template is committed; the real
# ~/.omp/agent/.env lives outside the repo and is never tracked by git.
#
# A key set in your shell environment (e.g. exported from ~/.bashrc/~/.zshrc)
# takes precedence over this file and makes the matching line here redundant.

# nvapi-... — https://build.nvidia.com — powers /nemotron, /diagram, /flux
NVIDIA_API_KEY=

# Google AI Studio / Gemini API key — powers /gemini, the Gemini CLI, and the
# Hindsight memory server's LLM backend
GEMINI_API_KEY=

# sk-... — https://platform.deepseek.com — powers /deepseek and /deepseek-r
DEEPSEEK_API_KEY=
