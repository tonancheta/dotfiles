#!/bin/sh
# Auto-rebuild graphify's knowledge graph after each commit.
#
# Installed globally via `core.hooksPath` (see bootstrap.sh), so this fires
# for every git repo on the machine, not just one project -- that's the
# point: propagate the same hook to every dev environment without touching
# each repo's own .git/hooks.
#
# Safety contract:
# - Opt-in per repo: only runs if graphify-out/graph.json already exists.
#   Never forces a first build on a repo that hasn't adopted graphify.
# - Never blocks or fails the commit: runs in the background, all output
#   goes to graphify-out/post-commit.log, and every exit path is silent.
# - Never overlaps: a simple lock directory (mkdir is atomic on POSIX)
#   skips a rebuild if one from a previous commit is still running --
#   the next commit's run picks up any files it missed via incremental
#   extraction, so skipping beats queueing here.

repo_root=$(git rev-parse --show-toplevel 2>/dev/null) || exit 0
graph_file="$repo_root/graphify-out/graph.json"
[ -f "$graph_file" ] || exit 0
command -v graphify >/dev/null 2>&1 || exit 0

lock_dir="$repo_root/graphify-out/.post-commit.lock"

# Clear a stale lock left by a crashed/killed run (>15 min old); a real
# incremental --update should finish long before that.
if [ -d "$lock_dir" ] && [ -n "$(find "$lock_dir" -maxdepth 0 -mmin +15 2>/dev/null)" ]; then
    rmdir "$lock_dir" 2>/dev/null
fi

mkdir "$lock_dir" 2>/dev/null || exit 0

log="$repo_root/graphify-out/post-commit.log"
{
    graphify "$repo_root" --update >>"$log" 2>&1
    rmdir "$lock_dir" 2>/dev/null
} </dev/null >/dev/null 2>&1 &

exit 0
